{
  "package": "alexey_no_sleep_fuel",
  "file": "alexey_no_sleep_fuel.scs",
  "display_name": "No Sleep & No Fuel (Alexey)",
  "category": "other",
  "version": "1.0",
  "icon": {
    "title": "NO SLEEP",
    "subtitle": "БЕЗ СНА И ТОПЛИВА",
    "bg": [
      25,
      35,
      80
    ],
    "accent": [
      255,
      220,
      90
    ]
  },
  "patches": {
    "def/economy_data.sii": [
      {
        "key": "maximum_driving_time",
        "value": "10000000"
      }
    ],
    "def/vehicle/truck/*/engine/*.sii": [
      {
        "require": "accessory_engine_data",
        "insert_after_key": "torque",
        "per_unit": "accessory_engine_data",
        "absent_key": "consumption_coef",
        "line": "consumption_coef: 0.0001\t# [mod alexey_no_sleep_fuel] fuel use x0.0001; not 0, so the dashboard range/average never divide by zero"
      }
    ]
  }
}